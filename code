  require('dotenv').config();
const express = require('express');
const cors = require('cors');
const { Pool } = require('pg');

const app = express();
const PORT = process.env.PORT || 5000;

// PostgreSQL Connection Pool Setup
const pool = new Pool({
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
  host: process.env.DB_HOST,
  port: process.env.DB_PORT,
  database: process.env.DB_NAME,
});

// Middleware
app.use(cors({
  origin: '*',
  methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'],
  allowedHeaders: ['Content-Type', 'Authorization']
}));
app.use(express.json());

// GET Aggregated Dashboard Data
app.get('/api/v1/dashboard', async (req, res) => {
  try {
    const remindersResult = await pool.query('SELECT * FROM reminders ORDER BY id DESC');
    const healthResult = await pool.query('SELECT * FROM health_metrics ORDER BY id DESC LIMIT 1');

    const weatherData = {
      city: 'York',
      country: 'UK',
      description: 'Partly Cloudy',
      temp_celsius: 18
    };

    const healthData = healthResult.rows[0] || {
      steps: 8450,
      bp_systolic: 120,
      bp_diastolic: 80,
      bmi: 23.5
    };

    res.json({
      success: true,
      data: {
        weather: weatherData,
        health: healthData,
        reminders: remindersResult.rows
      }
    });
  } catch (error) {
    console.error('Error fetching dashboard data:', error.message);
    res.status(500).json({ success: false, message: 'Failed to fetch dashboard data' });
  }
});

// POST New Reminder
app.post('/api/v1/reminders', async (req, res) => {
  const { title, category, due_date } = req.body;
  try {
    const query = 'INSERT INTO reminders (title, category, due_date, is_completed) VALUES ($1, $2, $3, false) RETURNING *';
    const result = await pool.query(query, [title, category || 'bill', due_date]);
    res.status(201).json({ success: true, data: result.rows[0] });
  } catch (error) {
    console.error('Error adding reminder:', error.message);
    res.status(500).json({ success: false, message: 'Failed to add reminder' });
  }
});

// PATCH Toggle Reminder Completion Status
app.patch('/api/v1/reminders/:id', async (req, res) => {
  const { id } = req.params;
  const { is_completed } = req.body;
  try {
    const query = 'UPDATE reminders SET is_completed = $1 WHERE id = $2 RETURNING *';
    const result = await pool.query(query, [is_completed, id]);
    if (result.rowCount === 0) {
      return res.status(404).json({ success: false, message: 'Reminder not found' });
    }
    res.json({ success: true, data: result.rows[0] });
  } catch (error) {
    console.error('Error updating reminder:', error.message);
    res.status(500).json({ success: false, message: 'Failed to update reminder' });
  }
});

// DELETE Reminder
app.delete('/api/v1/reminders/:id', async (req, res) => {
  const { id } = req.params;
  try {
    const query = 'DELETE FROM reminders WHERE id = $1 RETURNING *';
    const result = await pool.query(query, [id]);
    if (result.rowCount === 0) {
      return res.status(404).json({ success: false, message: 'Reminder not found' });
    }
    res.json({ success: true, message: 'Reminder deleted successfully', data: result.rows[0] });
  } catch (error) {
    console.error('Error deleting reminder:', error.message);
    res.status(500).json({ success: false, message: 'Failed to delete reminder' });
  }
});

app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});

